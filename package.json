{
  "name": "messenger-bot",
  "version": "1.0.0",
  "description": "Multi-page Facebook Messenger webhook server for SABO pages",
  "main": "src/index.js",
  "scripts": {
    "start": "node --use-system-ca src/index.js",
    "dev": "node --use-system-ca --watch src/index.js",
    "test:replies": "node --use-system-ca scripts/test-replies.cjs",
    "test:lead-flow": "node --use-system-ca scripts/test-lead-flow.cjs",
    "test:dedupe": "node --use-system-ca scripts/test-dedupe.cjs",
    "test:customer-safe": "node --use-system-ca scripts/test-customer-safe.cjs",
    "test:ollama": "node --use-system-ca scripts/test-ollama-reply.cjs",
    "test:hermes": "node --use-system-ca scripts/test-hermes-reply.cjs",
    "db:migrate": "node --use-system-ca scripts/run-migration.cjs",
    "test:lead": "node --use-system-ca scripts/test-lead-live.cjs",
    "e2e:meta": "node --use-system-ca scripts/e2e-meta-setup.cjs --production",
    "test:customer-safe-e2e": "node --use-system-ca scripts/test-customer-safe-e2e.cjs",
    "test:sales-discovery": "node --use-system-ca scripts/test-sales-discovery.cjs",
    "test:conversation-regression": "node --use-system-ca scripts/test-conversation-regression.cjs",
    "test:predeploy": "npm run test:customer-safe && npm run test:customer-safe-e2e && npm run test:lead-flow && npm run test:conversation-regression && npm run test:dedupe && npm run test:sales-discovery",
    "deploy:render": "npm run test:predeploy && node --use-system-ca scripts/deploy-render.cjs",
    "ship": "npm run test:predeploy && node --use-system-ca scripts/deploy-render.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  }
}
