PORT=3000
VERIFY_TOKEN=longsang_messenger_bot_2026

# Inbox poller — reply khi webhook không tới (Meta Dev mode chỉ role app; Render cold start)
INBOX_POLLER_ENABLED=true
INBOX_POLL_INTERVAL_MS=45000

# Hermes Gateway (ưu tiên khi bật — full agent + Ollama backend trong Hermes)
HERMES_ENABLED=false
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
# Prod Render: tunnel Hermes :8642 → HERMES_API_URL=https://xxx.trycloudflare.com

# LLM direct (fallback khi Hermes off / fail)
# Local: bật Ollama app + `ollama pull qwen3.5:9b`
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3.5:9b
# LLM_PROVIDER=auto   # auto | ollama | groq | openai
# Render prod: set OLLAMA_BASE_URL = URL tunnel tới PC (Cloudflare/Tailscale) — không dùng localhost

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Brain RAG (optional context — port 3012)
BRAIN_RAG_URL=http://127.0.0.1:3012
BRAIN_RAG_ENABLED=true
BRAIN_RAG_TIMEOUT_MS=5000
BRAIN_RAG_LIMIT=4

# Lead queue → Supabase `messenger_leads` + Telegram notify
# Run sql/002_messenger_leads.sql on shared Supabase trước khi bật production
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# LEAD_QUEUE_DRY_RUN=1   # test only — skip insert + Telegram

# Auto-fetch missing page tokens via Graph API
META_USER_ACCESS_TOKEN=
# MONOREPO_ROOT=D:\0.PROJECTS   # local dev: bootstrap keys từ admin/.env + sabo-mt/.env.local

# Facebook Page tokens (11 pages)
PAGE_ACCESS_TOKEN_SABO_DESIGN=
PAGE_ACCESS_TOKEN_SABO_WEB=
PAGE_ACCESS_TOKEN_SABO_AGENCY=
PAGE_ACCESS_TOKEN_SABO_APP=
PAGE_ACCESS_TOKEN_SABO_HUB=
PAGE_ACCESS_TOKEN_AI_ART_NEWBIE=
PAGE_ACCESS_TOKEN_BDS_VUNGTAU=
PAGE_ACCESS_TOKEN_APP_BILLIARDS=
PAGE_ACCESS_TOKEN_AI_NEWBIE_VN=
PAGE_ACCESS_TOKEN_SABO_MEDIA=
PAGE_ACCESS_TOKEN_SABO_BILLIARDS=
